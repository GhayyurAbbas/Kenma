<Window x:Class="Kenma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kenma" Width="400" Height="580" MinWidth="340" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="SubtleBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Padding="12,8,8,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppLogo" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Kenma" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Background="Transparent">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Checking engines…" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinBtn" Style="{StaticResource SubtleBtn}" Content="&#xE840;" Click="Pin_Click"/>
                    <Button Style="{StaticResource SubtleBtn}" Content="&#xE81C;" ToolTip="History" Click="History_Click"/>
                    <Button Style="{StaticResource SubtleBtn}" Content="&#xE74D;" ToolTip="Clear conversation" Click="Clear_Click"/>
                    <Button Style="{StaticResource SubtleBtn}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- conversation -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8,12,8">
            <StackPanel x:Name="Messages"/>
        </ScrollViewer>

        <!-- settings -->
        <Border x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Padding="16"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Engine" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="EngineBox" Margin="0,0,0,4" SelectionChanged="EngineBox_SelectionChanged"/>
                    <TextBlock x:Name="EngineCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel x:Name="KeyPanel">
                        <TextBlock Text="API key" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Stored encrypted in Windows Credential Manager, never in a file."/>
                    </StackPanel>

                    <StackPanel x:Name="UrlPanel">
                        <TextBlock Text="Server URL" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBox x:Name="BaseUrlBox" Margin="0,0,0,12"/>
                    </StackPanel>

                    <StackPanel x:Name="ModelPanel">
                        <TextBlock Text="Model" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelBox" IsEditable="True"/>
                            <Button x:Name="LoadModelsBtn" Grid.Column="1" Margin="8,0,0,0" Content="Load models" Click="LoadModels_Click"/>
                        </Grid>
                        <TextBlock x:Name="ModelCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    </StackPanel>

                    <StackPanel x:Name="TestPanel" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="TestBtn" Content="Test" MinWidth="88" Click="TestEngine_Click"/>
                        <TextBlock x:Name="TestResult" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="230"/>
                    </StackPanel>

                    <StackPanel x:Name="FallbackPanel" Margin="0,0,0,16">
                        <TextBlock Text="If it's unavailable, fall back to" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <CheckBox x:Name="FallbackCliCheck" Content="Claude Code (claude CLI)" Margin="0,0,0,4"/>
                        <CheckBox x:Name="FallbackLocalCheck" Content="Local model (Ollama or LM Studio)" Margin="0,0,0,4"/>
                        <CheckBox x:Name="FallbackTemplateCheck" Content="Offline template (no AI)"/>
                    </StackPanel>

                    <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Show / hide shortcut" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox x:Name="HotkeyBox" Margin="0,0,0,4" IsReadOnlyCaretVisible="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <TextBlock x:Name="HotkeyCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Click the box and press a key combination with Ctrl, Alt, Shift or Win."/>

                    <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AutoCopyCheck" Content="Copy enhanced prompt to clipboard" Margin="0,0,0,6"/>
                    <CheckBox x:Name="SaveHistoryCheck" Content="Save prompt history on this PC" Margin="0,0,0,8"/>

                    <TextBlock Text="Keep history for" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="RetentionBox" Margin="0,0,0,16" HorizontalAlignment="Left" MinWidth="160">
                        <ComboBoxItem Content="7 days" Tag="7"/>
                        <ComboBoxItem Content="30 days" Tag="30"/>
                        <ComboBoxItem Content="90 days" Tag="90"/>
                        <ComboBoxItem Content="Forever" Tag="0"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" Click="CancelSettings_Click"/>
                        <Button Content="Save" MinWidth="88" Style="{DynamicResource AccentButtonStyle}" Click="SaveSettings_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- history -->
        <Border x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed" Padding="16,16,16,8"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleBtn}" Content="&#xE8BB;" ToolTip="Close" Click="History_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleBtn}" Content="&#xE74D;" ToolTip="Clear all history" Click="ClearHistory_Click"/>
                    <TextBlock Text="History" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="HistorySearch" TextChanged="HistorySearch_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search history" Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- composer -->
        <Border Grid.Row="2" Padding="12,8,12,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LiveScorePanel" Orientation="Horizontal" Margin="2,0,0,6" Visibility="Collapsed"
                            ToolTip="Local pre-check: how complete your prompt is before enhancement">
                    <Ellipse x:Name="LiveScoreDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveScore" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBox x:Name="Input" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="36" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"/>
                <TextBlock x:Name="Hint" Grid.Row="1" Text="Enter a prompt to enhance" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Button x:Name="SendBtn" Grid.Row="1" Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0" Padding="0"
                        VerticalAlignment="Bottom" Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Enhance (Enter)" Click="Send_Click">
                    <TextBlock x:Name="SendGlyph" Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
