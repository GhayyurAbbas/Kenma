<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>Kenma</AssemblyName>
    <RootNamespace>Kenma</RootNamespace>
    <Product>Kenma</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('Kenma.ico')">Kenma.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kenma.Tests" />
  </ItemGroup>
</Project>
